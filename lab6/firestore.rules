rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, delete: if isSignedInOwner(userId);
      allow create, update: if isSignedInOwner(userId) && hasValidUserProfile();
    }

    function isSignedInOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function hasValidUserProfile() {
      return request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'name',
          'age',
          'city',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80
        && request.resource.data.age is int
        && request.resource.data.age >= 0
        && request.resource.data.age <= 120
        && request.resource.data.city is string
        && request.resource.data.city.size() <= 80;
    }
  }
}
